coverage.out
wizard.db
*.test

# Binaries a stray `go build` or a test drops in the repo root. Named rather than
# globbed: the directories under cmd/ share these names, and a pattern would hide
# their source too.
/wizardd
/noded
/wizard-api
/wizard-proxy
/wizard

# `make bin` output
/bin/

# Personal permission overrides, not team-wide
.claude/settings.local.json

# Python bytecode caches from the SDK and its tests
__pycache__/
*.pyc

# Scratch git worktrees an agent creates while working in this repo
.claude/worktrees/
